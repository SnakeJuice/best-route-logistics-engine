# Server Configuration
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=fleet_logistics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/fleet_logistics?schema=public"

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Routing Engine (OSRM)
OSRM_URL=http://localhost:5000