generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum OrderStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum RouteStatus {
  DRAFT
  OPTIMIZED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ------------------------------------------------------
// Models
// ------------------------------------------------------

model Vehicle {
  id           String   @id @default(uuid())
  name         String
  licensePlate String   @unique
  capacityKg   Float
  driverName   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  routes       Route[]
}

model Order {
  id           String      @id @default(uuid())
  customerName String
  address      String
  latitude     Float
  longitude    Float
  weightKg     Float
  status       OrderStatus @default(PENDING)
  stop         Stop?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Route {
  id             String      @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id])
  status         RouteStatus @default(DRAFT)
  totalDistanceM Float?
  totalDurationS Float?
  polyline       String?     @db.Text
  stops          Stop[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Stop {
  id          String   @id @default(uuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence    Int
  estimatedEta DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}